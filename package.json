{
  "name": "mouthpiece",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun test",
    "daemon": "bun packages/cli/src/main.ts start",
    "mouthpiece": "bun packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@mouthpiece/core": "workspace:*",
    "@mouthpiece/providers": "workspace:*",
    "@mouthpiece/summarizers": "workspace:*",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
